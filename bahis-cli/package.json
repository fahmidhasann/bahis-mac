{
  "name": "bahis-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Command line for validated BAHIS Patient Registry entry, submission and verification",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "bin": {
    "bahis": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit && npm test",
    "doctor": "node scripts/doctor.mjs",
    "install-skill": "node scripts/install-skill.mjs",
    "sync": "npm run check && npm run build && npm run doctor",
    "audit:dropdowns": "tsx src/dropdown-audit.ts --output ../../artifacts/bahis-dropdown-audit.csv"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.10",
    "better-sqlite3": "13.0.3",
    "csv-parse": "6.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
