{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'com.github.chameleonhub.chameleon',
  publish: {
    "provider": "github",
    "owner": "chameleonhub",
    "repo": "chameleon-workstation"
  },
  productName: 'BAHIS',
  executableName: 'bahis',
  asar: true,
  asarUnpack: [
    'node_modules/better-sqlite3/**'
  ],
  npmRebuild: true,
  directories: {
    output: 'release/${version}',
    buildResources: 'public'
  },
  files: [
    'dist-electron',
    'dist'
  ],
  extraFiles: [
    'public/**/*'
  ],
  mac: {
    executableName: 'BAHIS',
    target: [
      {
        target: 'dmg',
        arch: [
          'arm64'
        ]
      },
      {
        target: 'dir',
        arch: [
          'arm64'
        ]
      }
    ],
    icon: './public/icon.icns',
    category: 'public.app-category.medical',
    artifactName: '${productName}_${version}_mac_arm64.${ext}',
    identity: '-',
    hardenedRuntime: true,
    entitlements: './public/entitlements.mac.plist',
    entitlementsInherit: './public/entitlements.mac.plist',
    gatekeeperAssess: false,
    notarize: false
  },
  win: {
    target: [
      {
        target: 'nsis',
        arch: [
          'x64'
        ]
      }
    ],
    icon: './public/icon.png',
    artifactName: '${productName}_${version}.${ext}'
  },
  linux: {
    target: [
      {
        target: 'AppImage',
        arch: [
          'x64',
          'arm64'
        ]
      }
    ],
    icon: './public/icon.png',
    category: 'Science',
    artifactName: '${productName}_${version}_linux_${arch}.${ext}'
  },
  nsis: {
    oneClick: false,
    perMachine: true,
    allowElevation: true,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: 'always',
    menuCategory: 'bahis',
    deleteAppDataOnUninstall: false,
    shortcutName: 'BAHIS ${version}',
  }
}
